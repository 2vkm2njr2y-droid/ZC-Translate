@echo off
rem ZC portable launcher. Generated by scripts/build_portable.ps1.
rem Model lookup order: package models, inherited ZC_MODELS_DIR, parent models,
rem grandparent models, then the workspace models path baked in at build time.
setlocal EnableExtensions
cd /d "%~dp0"

set "ZC_INHERITED_MODELS=%ZC_MODELS_DIR%"
set "ZC_MODELS_DIR="
set "ZC_WORKSPACE_MODELS=__ZC_WORKSPACE_MODELS__"

if exist "%~dp0models\" set "ZC_MODELS_DIR=%~dp0models"
if not defined ZC_MODELS_DIR if defined ZC_INHERITED_MODELS if exist "%ZC_INHERITED_MODELS%\" set "ZC_MODELS_DIR=%ZC_INHERITED_MODELS%"
if not defined ZC_MODELS_DIR if exist "%~dp0..\models\" set "ZC_MODELS_DIR=%~dp0..\models"
if not defined ZC_MODELS_DIR if exist "%~dp0..\..\models\" set "ZC_MODELS_DIR=%~dp0..\..\models"
if not defined ZC_MODELS_DIR if exist "%ZC_WORKSPACE_MODELS%\" set "ZC_MODELS_DIR=%ZC_WORKSPACE_MODELS%"

if not defined ZC_MODELS_DIR (
  echo [ZC] Models folder not found. The app will start; open Settings to check the model status.
  echo [ZC] Put a models folder next to ZCTranslate.exe, or pass --models-dir.
)

start "" "%~dp0ZCTranslate.exe" %*
